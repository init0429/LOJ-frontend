# Supabase 프로젝트 주소와 공개(anon/publishable) 키. 브라우저에 그대로 실린다.
# secret 키는 여기에 두지 않는다. 프론트엔드는 쓰지 않으며, 백엔드와 채점기만 쓴다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# 브라우저가 채점 API를 부르는 주소 (/submit, /test_run 앞부분)
NEXT_PUBLIC_API_URL=https://example.com/api

# Next 서버가 /api/* 요청을 넘겨줄 백엔드 주소. 운영 빌드에서는 꼭 적어야 한다(비우면 빌드가 멈춤).
# 개발할 때 비우면 http://localhost:8000을 쓴다.
BACKEND_API_URL=http://backend:8000

